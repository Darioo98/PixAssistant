{
  "name": "dock",
  "productName": "Dock",
  "version": "0.1.0",
  "description": "Barra multifunzione per Windows con la mascotte Pix",
  "private": true,
  "author": "Dario Cavallo",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "native": "dotnet publish native/PixNative/PixNative.csproj -c Release -o resources/native",
    "dist": "npm run native:release && npm run build && electron-builder --win nsis",
    "native:release": "dotnet publish native/PixNative/PixNative.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:EnableCompressionInSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:DebugType=none -o resources/native"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.299",
    "i18next": "^26.4.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/flubber": "^0.4.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "flubber": "^0.4.2",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "svg-path-properties": "^1.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
